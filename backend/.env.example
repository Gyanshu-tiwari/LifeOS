# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=LIFEOS API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
# asyncpg driver required: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://lifeos_user:your_password@localhost:5432/lifeos_db

# ─── Firebase Authentication ──────────────────────────────────────────────────
# Leave empty to bypass auth in development (logs a warning).
# Set to your Firebase project ID to enable token verification.
FIREBASE_PROJECT_ID=

# ─── AI / Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ─── Google Maps / Places ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Optional: Async Workers (ARQ + Redis) ───────────────────────────────────
# Only needed when running background plan-generation workers.
# Install optional deps first: uv add arq redis
# REDIS_URL=redis://localhost:6379